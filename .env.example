# Inputs consumed by docker-compose.yml and docker-compose.dev.yml.
# Copy to .env, replace every placeholder, and set the file to mode 0600.
# .env is gitignored and must never be committed.

# GitHub contribution calendar — server-only; never prefix secrets with VITE_.
# A classic PAT with only the read:user scope includes publicized private counts.
GITHUB_TOKEN=<github-classic-pat>

# Spin Cycle — credentials for the existing per-environment PostgreSQL service.
SPIN_CYCLE_POSTGRES_USER=<spin-cycle-user>
SPIN_CYCLE_POSTGRES_PASS=<spin-cycle-password>

# Long Exposure — credentials for the existing per-environment PostgreSQL service.
# Compose must require these values; do not restore a checked-in fallback.
LONG_EXPOSURE_POSTGRES_USER=<long-exposure-user>
LONG_EXPOSURE_POSTGRES_PASS=<long-exposure-password>

# Temporary legacy joi SSH collector input. Leave unset when those obsolete
# services are disabled. Use the full tailnet FQDN, never a bare hostname.
BTOP_JOI_SSH_HOST=vedanta@joi.<your-tailnet>.ts.net

# Found Footy API, NATS, btop inventory, and browser API URLs are currently
# declared directly in Compose. They are not secret inputs to this file.
